{
  "name": "vite-tailwind-boilerplate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cleanup": "rm -rf dist",
    "dev": "cross-env NODE_ENV=development vite --host",
    "build": "npm run cleanup && cross-env NODE_ENV=production vite build --mode production",
    "generate:component": "node ./inc/Commands/CreateComponent/index.js",
    "g:c": "npm run generate:component"
  },
  "devDependencies": {
    "@nietthijmen/wordpress-vite-plugin": "^1.0.3",
    "@types/aos": "^3.0.4",
    "autoprefixer": "^10.4.12",
    "cross-env": "^10.1.0",
    "cssnano": "^5.1.14",
    "glob": "^11.0.3",
    "postcss": "^8.4.18",
    "postcss-nested": "^6.0.0",
    "sass": "^1.93.2",
    "tailwindcss": "^3.2.1",
    "terser": "^5.16.0",
    "vite": "^7.3.1",
    "vite-plugin-glob": "^0.3.2",
    "vite-plugin-sass-glob-import": "^6.0.0",
    "fs-extra": "^10.1.0",
    "prompts": "^2.4.2"
  },
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "aos": "^2.3.4"
  }
}
